{
  "name": "ollopa-extension",
  "displayName": "Ollopa",
  "description": "AI Coding Platform — chat-centric multi-agent assistant with persistent memory.",
  "version": "0.0.1",
  "private": true,
  "publisher": "ollopa",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "contributes": {
    "configuration": {
      "title": "Ollopa",
      "properties": {
        "ollopa.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the workspace the agent edits. If empty, uses the first opened folder."
        },
        "ollopa.omnirouteUrl": {
          "type": "string",
          "default": "http://localhost:20128",
          "description": "Base URL for the OmniRoute LLM router. Empty disables OmniRoute."
        },
        "ollopa.forceDirect": {
          "type": "boolean",
          "default": false,
          "description": "Skip OmniRoute and go straight to the first available direct provider."
        },
        "ollopa.directProviders": {
          "type": "array",
          "default": [
            { "name": "openrouter", "baseUrl": "https://openrouter.ai/api/v1", "enabled": true, "keyAlias": "__openrouter__" },
            { "name": "deepseek", "baseUrl": "https://api.deepseek.com/v1", "enabled": false, "keyAlias": "deepseek_key1" }
          ],
          "description": "Direct OpenAI-compatible providers tried in order when OmniRoute is unavailable or direct mode is forced. API keys are stored under ollopa.providerKey.<keyAlias> in SecretStorage. Use keyAlias '__openrouter__' to reuse the global OpenRouter key."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ollopa",
          "title": "Ollopa",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ollopa": [
        {
          "type": "webview",
          "id": "ollopa.chat",
          "name": "Ollopa Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "ollopa.openPanel",
        "title": "Ollopa: Open Panel"
      },
      {
        "command": "ollopa.configure",
        "title": "Ollopa: Configure"
      },
      {
        "command": "ollopa.startOmniRoute",
        "title": "Ollopa: Start OmniRoute"
      },
      {
        "command": "ollopa.addProviderKey",
        "title": "Ollopa: Add Provider API Key"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}
